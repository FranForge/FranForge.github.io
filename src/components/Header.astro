---
const { lang = "en" } = Astro.props;

// Definición de variables de texto
let aboutMe, projects, skills, experience, blog, contact;

// Lógica de traducción
switch (lang) {
    case "es":
        aboutMe = "Sobre mí";
        projects = "Proyectos";
        skills = "Habilidades";
        experience = "Experiencia";
        blog = "Blogs";
        contact = "Contacto";
        break;
    case "en":
    default:
        aboutMe = "About me";
        projects = "Projects";
        skills = "Skills";
        experience = "Experience";
        blog = "Blogs";
        contact = "Contact";
        break;
}
---

<header 
    class="header scroll-effect theme-header" 
    id="header" 
    data-scroll-min-y="100" 
    data-scroll-max-y="0"
>
    <section class="content">

        <nav class="navigation">

            <a href={`/${lang}/home`}>
                <img src="/icons/logo.svg" alt="FranForge">
            </a>

            <a href={`/${lang}/home/#presentation`} class="link desktop">
                {aboutMe}
            </a>

            <a href={`/${lang}/projects/all`} class="link">
                {projects}
            </a>

            <a href={`/${lang}/home/#skills`} class="link desktop">
                {skills}
            </a>

            <a href={`/${lang}/home/#experience`} class="link desktop">
                {experience}
            </a>

            <a href={`/${lang}/home/#blogs-and-articles`} class="link desktop">
                {blog}
            </a>

            <a href={`/${lang}/home/#contact`} class="link">
                {contact}
            </a>

        </nav>

    </section>
</header>

<script>
    import "../scripts/scrollEffector.js";
</script>