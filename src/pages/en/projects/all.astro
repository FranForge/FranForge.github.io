---
//Proyects
import projectsData from '../../../data/en/projects.json'

const allProjects = projectsData;

//Proyects sections
const releasedProjects = allProjects.filter(
  p => p["web-category"] === "released"
);

const upcomingProjects = allProjects.filter(
  p => p["web-category"] === "upcoming"
);

const prototypeProjects = allProjects.filter(
  p => p["web-category"] === "prototype"
);

const otherProjects = allProjects.filter(
  p => p["web-category"] === "other"
);

//Tags
const allTags = [...new Set(projectsData.flatMap(project => project.tags))];

//Components
import Layout from "../../../layouts/Layout.astro";
import VideoHero from '../../../components/VideoHero.astro';
import InformationSection from '../../../components/InformationSection.astro';
import VerticalCard from '../../../components/VerticalCard.astro';
import VerticalCardsContainer from '../../../components/VerticalCardsContainer.astro';
---

<Layout title="Projects | FranForge - Game Developer">

    <VideoHero
        videoSrc = "/media/projects/magictory/summary.mp4"
		title = "Projects"
		rotatingText = "Unity, Unreal, Web, C#"
    />

	<!-- FILTERS -->
	<div id="filters">
		<h2>Filter by tags</h2>

		{allTags.map(tag => (
		<button class="tag-btn" data-tag={tag}>
			{tag}
		</button>
		))}

		<button id="clear-filters">Clear</button>
	</div>

	<div id="filtered-view" style="display: none;">

		<InformationSection>
			<h1>Filtered Projects</h1>
			<p>Projects matching the selected tags: <span id="filter-tags"></span>.</p>
			<VerticalCardsContainer id="filtered-container">
				
				{allProjects.map(p => (
					<VerticalCard
						name={p.title}
						description={p.description}
						date={p.date}
						attributes={p.attributes}
						tags={p.tags.join(",")}
						img={`/media/projects/${p.id}/thumbnail.webp`}
						url={`/en/projects/${p.id}`}
					/>
				))}
				
			</VerticalCardsContainer>

			<p id="no-results" style="display: none;">
				No projects match the selected tags.
			</p>

		</InformationSection>

	</div>

	<div id="default-view">
		<InformationSection>

			{releasedProjects && releasedProjects.length > 0 && (

				<h1 id="released-projects">Released</h1>
				<p>Production-ready applications and fully launched games.</p>

				<VerticalCardsContainer>

					{releasedProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/en/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}

			{upcomingProjects && upcomingProjects.length > 0 && (

				<h1 id="upcoming-projects">Upcoming</h1>
				<p>Feature-complete projects currently in the final stages 
					of polishing or awaiting official launch.</p>

				<VerticalCardsContainer>

					{upcomingProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/en/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}

			{prototypeProjects && prototypeProjects.length > 0 && (

				<h1 id="prototypes-projects">Prototypes</h1>
				<p>A collection of technical experiments and gameplay mechanics.</p>

				<VerticalCardsContainer>

					{prototypeProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/en/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}

			{otherProjects && otherProjects.length > 0 && (

				<h1 id="others-projects">Other Projects</h1>

				<VerticalCardsContainer>

					{otherProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/en/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}
		</InformationSection>
	</div>

</Layout>

<script>
	import "../../../scripts/projectsFilter.js"
</script>