---
//Blogs data.
import blogs from "../../../data/es/blogs-and-articles.json";

//Asignacion de ruta.
export async function getStaticPaths(){
    return blogs.map((blog) => ({
        params: {id: blog.id},
        props: {blog}
    }));
}

const { blog } = Astro.props;

import Layout from "../../../layouts/Layout.astro";
import BlogContent from "../../../components/BlogContent.astro";
---

<Layout title={`${blog.title} | FranForge - Game Developer`} lang="es">
    
    <BlogContent blog={blog} lang="es" />

</Layout>