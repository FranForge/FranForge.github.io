---
//Proyects
import projectsData from '../../../data/es/projects.json'

const allProjects = projectsData;

//Proyects sections
const releasedProjects = allProjects.filter(
  p => p["web-category"] === "released"
);

const upcomingProjects = allProjects.filter(
  p => p["web-category"] === "upcoming"
);

const prototypeProjects = allProjects.filter(
  p => p["web-category"] === "prototype"
);

const otherProjects = allProjects.filter(
  p => p["web-category"] === "other"
);

//Tags
const rawTags = projectsData.flatMap(project => project.tags);

const uniqueTags = rawTags.filter((tag, index, self) => 
    index === self.findIndex((t) => t.title === tag.title)
);

const primaryTags = uniqueTags
    .filter(tag => tag.type === "primary")
    .map(tag => tag.title)
    .sort();

const secondaryTags = uniqueTags
    .filter(tag => tag.type === "secondary")
    .map(tag => tag.title)
    .sort();

const stateTags = uniqueTags
    .filter(tag => tag.type === "state")
    .map(tag => tag.title)
    .sort();

//Components
import Layout from "../../../layouts/Layout.astro";
import VideoHero from '../../../components/VideoHero.astro';
import InformationSection from '../../../components/InformationSection.astro';
import VerticalCard from '../../../components/VerticalCard.astro';
import VerticalCardsContainer from '../../../components/VerticalCardsContainer.astro';
---

<Layout title="Proyectos | FranForge - Game Developer" lang="es">

    <VideoHero
        videoSrc = "/media/projects/magictory/summary.mp4"
        title = "Proyectos"
        rotatingText = "Unity, Unreal, Web, C#"
    />

	<!-- FILTERS -->
	<div id="filters" class="filters-section">
		<h2>Filtrar por etiquetas</h2>

		{primaryTags && primaryTags.length > 0 && (
			<h3>Categorias</h2>
			<div class="content">
				{primaryTags.map(tag => (
					<button class="tag-btn" data-tag={tag}>
						{tag}
					</button>
				))}
			</div>
		)}

		{stateTags && stateTags.length > 0 && (
			<h3>Estado</h2>
			<div class="content">
				{stateTags.map(tag => (
					<button class="tag-btn" data-tag={tag}>
						{tag}
					</button>
				))}
			</div>
		)}

		{secondaryTags && secondaryTags.length > 0 && (
			<h3>Otras Etiquetas</h2>
			<div class="content">
				{secondaryTags.map(tag => (
					<button class="tag-btn" data-tag={tag}>
						{tag}
					</button>
				))}
			</div>
		)}

		<button id="clear-filters" class="clear-btn">Limpiar Filtros</button>
		
	</div>

	<div id="filtered-view" style="display: none;">

		<InformationSection>
			<h1>Proyectos Filtrados</h1>
			<p>Proyectos que coinciden con las etiquetas seleccionadas: <span id="filter-tags"></span>.</p>
			<VerticalCardsContainer id="filtered-container">
				
				{allProjects.map(p => (
					<VerticalCard
						name={p.title}
						description={p.description}
						date={p.date}
						attributes={p.attributes}
						tags={p.tags.map(tag => tag.title).join(",")}
						img={`/media/projects/${p.id}/thumbnail.webp`}
						url={`/es/projects/${p.id}`}
					/>
				))}
				
			</VerticalCardsContainer>

			<p id="no-results" style="display: none;">
				No hay proyectos que coincidan con las etiquetas seleccionadas.
			</p>

		</InformationSection>

	</div>

	<div id="default-view">
		<InformationSection>

			{releasedProjects && releasedProjects.length > 0 && (

				<h1 id="released-projects">Publicados</h1>
				<p>Aplicaciones listas para producción y juegos lanzados oficialmente.</p>

				<VerticalCardsContainer>

					{releasedProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/es/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}

			{upcomingProjects && upcomingProjects.length > 0 && (

				<h1 id="upcoming-projects">Próximamente</h1>
				<p>
					Proyectos con funcionalidades completas en fase final de 
					pulido o esperando su lanzamiento oficial.
				</p>

				<VerticalCardsContainer>

					{upcomingProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/es/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}

			{prototypeProjects && prototypeProjects.length > 0 && (

				<h1 id="prototypes-projects">Prototipos</h1>
				<p>
					Una colección de experimentos técnicos y mecánicas de 
					juego en desarrollo.
					</p>

				<VerticalCardsContainer>

					{prototypeProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/es/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}

			{otherProjects && otherProjects.length > 0 && (

				<h1 id="others-projects">Other Projects</h1>

				<VerticalCardsContainer>

					{otherProjects.map((item) => (
						<VerticalCard
							name={item.title}
							description={item.description}
							date={item.date}
							attributes={item.attributes}
							img={`/media/projects/${item.id}/thumbnail.webp`}
							url={`/es/projects/${item.id}`}
						/>
					))}
					
				</VerticalCardsContainer>

			)}

		</InformationSection>
	</div>

</Layout>

<script>
	import "../../../scripts/projectsFilter.js"
</script>