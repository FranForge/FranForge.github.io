---
import VideoHero from "../components/VideoHero.astro";
import Layout from "../layouts/Layout.astro";

// src/pages/index.astro
---

<Layout title="FranForge - Game Developer">
  <VideoHero
		videoSrc = "/media/projects/magictory/summary.mp4"
	/>
</Layout>

<script is:inline>
  const userLang = navigator.language || navigator.userLanguage;
      
      // Si empieza por 'es', vamos a /es/, si no, a /en/
      if (userLang.startsWith('es')) {
        window.location.pathname = '/es/home/';
      } else {
        window.location.pathname = '/en/home/';
      }
</script>